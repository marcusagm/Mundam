{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mundam",
  "version": "0.1.0",
  "identifier": "com.marcusmaia.mundam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Mundam",
        "width": 1200,
        "height": 800,
        "minHeight": 800,
        "minWidth": 1200,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "hiddenTitle": true,
        "shadow": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 16
        }
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "title": "Mundam — Starting",
        "width": 480,
        "height": 360,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#212121"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/soundfonts/": "resources/soundfonts/"
    }
  }
}
