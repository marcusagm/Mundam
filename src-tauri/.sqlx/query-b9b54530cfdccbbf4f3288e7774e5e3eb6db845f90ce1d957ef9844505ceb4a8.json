  "query": "\n        SELECT df.asset_id as \"asset_id!\",\n               df.content_hash,\n               df.perceptual_hash,\n               df.block_hash,\n               df.thumb_hash,\n               df.width,\n               df.height,\n               df.file_size\n        FROM duplicate_fingerprints df\n        JOIN assets a ON df.asset_id = a.id\n        WHERE df.perceptual_hash IS NOT NULL \n          AND a.state != 'trashed'\n        ",
