{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "design-system"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "fs:default",
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "**" }]
    },
    "allow-copy-files-to-clipboard",
    "allow-rename-file",
    "allow-toggle-favorite",
    "allow-move-to-trash",
    "allow-restore-from-trash",
    "allow-empty-trash",
    "dialog:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-decorations",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "allow-start-indexing",
    "allow-create-tag",
    "allow-update-tag",
    "allow-delete-tag",
    "allow-get-all-tags",
    "allow-add-tag-to-asset",
    "allow-remove-tag-from-asset",
    "allow-get-tags-for-asset",
    "allow-add-tags-to-assets-batch",
    "allow-remove-tags-from-assets-batch",
    "allow-replace-tags-for-assets-batch",
    "allow-get-assets-filtered",
    "allow-get-asset-count-filtered",
    "allow-get-library-stats",
    "allow-update-asset-rating",
    "allow-update-asset-notes",
    "allow-get-asset-exif",
    "allow-request-thumbnail-regenerate",
    "allow-add-location",
    "allow-remove-location",
    "allow-get-locations",
    "allow-get-all-subfolders",
    "allow-get-subfolder-counts",
    "allow-get-location-root-counts",
    "allow-get-smart-folders",
    "allow-save-smart-folder",
    "allow-update-smart-folder",
    "allow-delete-smart-folder",
    "allow-get-setting",
    "allow-set-setting",
    "allow-run-db-maintenance",
    "allow-send-telemetry-log",
    "allow-get-library-supported-formats",
    "allow-get-audio-waveform-data",
    "allow-get-cache-stats",
    "allow-cleanup-cache",
    "allow-clear-cache",
    "allow-set-thumbnail-priority",
    "allow-get-streaming-token",
    "allow-get-asset-colors",
    "allow-reextract-asset-colors",
    "allow-reextract-all-colors",
    "allow-get-assets",
    "allow-get-asset",
    "allow-list-folders",
    "allow-list-tags",
    "allow-search-assets",
    "allow-create-folder",
    "allow-set-asset-folder",
    "allow-update-asset-tags",
    "allow-prioritize-thumbnails",
    "allow-get-app-settings",
    "allow-update-app-settings",
    "allow-needs-transcoding",
    "allow-is-native-format",
    "allow-get-stream-url",
    "allow-get-quality-options",
    "allow-transcode-file",
    "allow-is-cached",
    "allow-ffmpeg-available",
    "allow-get-streaming-cache-stats",
    "allow-cleanup-cache-streaming",
    "allow-clear-cache-streaming",
    "allow-verify-thumbnails",
    "allow-get-duplicate-groups",
    "allow-get-duplicate-candidates",
    "allow-resolve-duplicate-group",
    "allow-start-duplicate-scan",
    "allow-cancel-duplicate-scan",
    "allow-apply-duplicate-metadata-merge",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:9876/*"
        },
        {
          "url": "http://localhost:9876/*"
        }
      ]
    },
    "clipboard-manager:default"
  ]
}
