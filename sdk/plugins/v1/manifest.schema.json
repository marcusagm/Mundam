{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Mundam plugin manifest v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "manifestVersion",
        "id",
        "name",
        "description",
        "keywords",
        "icon",
        "targets",
        "version",
        "publisher",
        "license",
        "engines",
        "permissions",
        "contributes"
    ],
    "allOf": [
        {
            "if": {
                "anyOf": [
                    { "properties": { "permissions": { "contains": { "const": "assetPreview.read" } } } },
                    {
                        "required": ["optionalPermissions"],
                        "properties": { "optionalPermissions": { "contains": { "const": "assetPreview.read" } } }
                    }
                ]
            },
            "then": { "properties": { "permissions": { "contains": { "const": "selection.read" } } } }
        },
        {
            "if": { "required": ["worker"] },
            "then": {
                "anyOf": [
                    { "properties": { "permissions": { "contains": { "const": "assetPreview.read" } } } },
                    {
                        "required": ["optionalPermissions"],
                        "properties": { "optionalPermissions": { "contains": { "const": "assetPreview.read" } } }
                    }
                ]
            }
        }
    ],
    "if": {
        "properties": {
            "contributes": {
                "type": "object",
                "required": ["inspectorSections"],
                "properties": { "inspectorSections": { "type": "array", "minItems": 1 } }
            }
        }
    },
    "then": {
        "properties": {
            "permissions": {
                "type": "array",
                "allOf": [
                    { "contains": { "const": "selection.read" } },
                    { "contains": { "const": "assetData.own.read" } }
                ]
            },
            "contributes": {
                "type": "object",
                "required": ["assetFields"],
                "properties": { "assetFields": { "type": "array", "minItems": 1 } }
            }
        }
    },
    "else": {
        "properties": {
            "contributes": {
                "type": "object",
                "required": ["screens"],
                "properties": {
                    "screens": { "type": "array", "minItems": 1 },
                    "assetFields": { "type": "array", "maxItems": 0 }
                }
            }
        }
    },
    "properties": {
        "manifestVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/namespace" },
        "name": { "$ref": "#/$defs/title" },
        "description": { "type": "string", "$ref": "#/$defs/plainText", "maxLength": 240 },
        "keywords": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string", "$ref": "#/$defs/plainText", "maxLength": 32 }
        },
        "icon": {
            "type": "string",
            "pattern": "^assets/(?!((con|prn|aux|nul)|((com|lpt)[0-9]))\\.png$)[a-z][a-z0-9-]{0,31}\\.png$(?![\\s\\S])"
        },
        "targets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/target" }
        },
        "version": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$(?![\\s\\S])"
        },
        "publisher": { "$ref": "#/$defs/namespace" },
        "license": { "type": "string", "$ref": "#/$defs/plainText", "maxLength": 128 },
        "engines": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mundamApi"],
            "properties": {
                "mundamApi": {
                    "type": "string",
                    "pattern": "^>=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*) <(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$(?![\\s\\S])"
                }
            }
        },
        "permissions": { "$ref": "#/$defs/permissions" },
        "optionalPermissions": { "$ref": "#/$defs/permissions" },
        "worker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "abi"],
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
                "abi": { "enum": ["preview-probe-v1", "wit-preview-check-v1"] }
            }
        },
        "contributes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "assetFields": {
                    "type": "array",
                    "maxItems": 32,
                    "items": { "$ref": "#/$defs/assetField" }
                },
                "inspectorSections": {
                    "type": "array",
                    "maxItems": 8,
                    "items": { "$ref": "#/$defs/inspectorSection" }
                },
                "screens": {
                    "type": "array",
                    "maxItems": 4,
                    "items": { "$ref": "#/$defs/screen" }
                },
                "commands": {
                    "type": "array",
                    "maxItems": 8,
                    "items": { "$ref": "#/$defs/command" }
                }
            }
        }
    },
    "$defs": {
        "plainText": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\s)[^\\u0000-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069\\ufeff]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u2028-\\u202e\\u2066-\\u2069\\ufeff](?![\\s\\S])"
        },
        "title": { "type": "string", "$ref": "#/$defs/plainText", "maxLength": 80 },
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$(?![\\s\\S])" },
        "namespace": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9-]{0,31}(\\.[a-z][a-z0-9-]{0,31})+$(?![\\s\\S])"
        },
        "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "architecture"],
            "properties": {
                "platform": { "enum": ["all", "windows", "mac", "linux"] },
                "architecture": { "enum": ["all", "x64", "arm64", "arm"] }
            }
        },
        "permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["selection.read", "assetPreview.read", "assetData.own.read", "assetData.own.write"] }
        },
        "assetField": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "schemaVersion", "default"],
            "properties": {
                "id": { "$ref": "#/$defs/slug" },
                "type": { "const": "boolean" },
                "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                "default": { "type": "boolean" }
            }
        },
        "command": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "action"],
            "properties": {
                "id": { "$ref": "#/$defs/slug" },
                "title": { "$ref": "#/$defs/title" },
                "suggestedShortcut": {
                    "type": "string",
                    "pattern": "^Mod\\+(Shift\\+)?Key[A-Z]$(?![\\s\\S])"
                },
                "action": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "screen"],
                    "properties": {
                        "kind": { "const": "openScreen" },
                        "screen": { "$ref": "#/$defs/slug" }
                    }
                }
            }
        },
        "screen": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "blocks"],
            "properties": {
                "id": { "$ref": "#/$defs/slug" },
                "title": { "$ref": "#/$defs/title" },
                "blocks": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                        "oneOf": [
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["kind", "text"],
                                "properties": {
                                    "kind": { "const": "paragraph" },
                                    "text": {
                                        "type": "string",
                                        "$ref": "#/$defs/plainText",
                                        "maxLength": 240
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["kind", "items"],
                                "properties": {
                                    "kind": { "const": "list" },
                                    "items": {
                                        "type": "array",
                                        "minItems": 1,
                                        "maxItems": 12,
                                        "items": {
                                            "type": "string",
                                            "$ref": "#/$defs/plainText",
                                            "maxLength": 120
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }
            }
        },
        "inspectorSection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "when", "fields"],
            "properties": {
                "id": { "$ref": "#/$defs/slug" },
                "title": { "$ref": "#/$defs/title" },
                "viewportActionLabel": { "$ref": "#/$defs/title" },
                "sidebarLinkLabel": { "$ref": "#/$defs/title" },
                "titleBarActionLabel": { "$ref": "#/$defs/title" },
                "when": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["selectionCount"],
                    "properties": { "selectionCount": { "const": 1 } }
                },
                "fields": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["field", "label", "control"],
                        "properties": {
                            "field": { "$ref": "#/$defs/slug" },
                            "label": { "$ref": "#/$defs/title" },
                            "control": { "const": "checkbox" },
                            "readOnly": { "type": "boolean", "default": false }
                        }
                    }
                }
            }
        }
    }
}
